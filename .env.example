# ── Variables de entorno — copiar a .env y ajustar valores ───────────────────

# Nginx — puerto del host (tu máquina). El acceso será http://localhost:<puerto>
# Cámbialo si el 8080 está ocupado (ej. 9090).
NGINX_HOST_PORT=8080

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-segura
DEBUG=1
ENV_TYPE=PROD
# Orígenes de confianza para CSRF (login del admin detrás de Nginx).
# Debe coincidir con el host:puerto por el que accedes. Si cambias NGINX_HOST_PORT,
# ajusta también aquí (ej. http://localhost:9090).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://127.0.0.1

# Flask Pagos
FLASK_ENV=production
DATABASE_URL=sqlite:////app/data/pagos.db
PORT=5000

# Celery + Redis (Message Broker)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Servicio del equipo aliado (URL de su endpoint de información).
# Por defecto usa una API pública gratuita (FakeStore) como aliado de demo.
# Cuando tengas la URL real del aliado, reemplázala aquí.
ALIADO_API_URL=https://fakestoreapi.com/products?limit=5
