# ── Variables de entorno — copiar a .env y ajustar valores ───────────────────

# Nginx — puerto del host (tu máquina). El acceso será http://localhost:<puerto>
# Cámbialo si el 8080 está ocupado (ej. 9090).
NGINX_HOST_PORT=8080

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-segura
DEBUG=0
ENV_TYPE=PROD

# Flask Pagos
FLASK_ENV=production
DATABASE_URL=sqlite:////app/data/pagos.db
PORT=5000
